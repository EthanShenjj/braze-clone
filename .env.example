# Optional Unlayer project ID from https://console.unlayer.com/
# Project IDs are public. Never put an Unlayer API key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_UNLAYER_PROJECT_ID=
# Pin the embedded builder version for reproducible design loading and exports.
NEXT_PUBLIC_UNLAYER_BUILDER_VERSION=1.489.0

# Optional SDK user authentication, used when an app requires signatures.
SDK_AUTH_SECRET=

# Optional push provider credentials. Presence is reported in Push Settings.
APNS_KEY=
FCM_SERVICE_ACCOUNT=
WEB_PUSH_PRIVATE_KEY=

# Optional OpenAI-compatible endpoint for configured workspace agents.
WORKSPACE_AI_ENDPOINT=
WORKSPACE_AI_API_KEY=
WORKSPACE_AI_MODEL=
