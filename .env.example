# Beefree SDK credentials from https://developers.beefree.io/
# These values are read only by the server-side token proxy.
BEEFREE_CLIENT_ID=
BEEFREE_CLIENT_SECRET=

# Optional stable workspace user identifier used by Beefree authorization.
BEEFREE_UID=braze-local-user

# Optional SDK user authentication, used when an app requires signatures.
SDK_AUTH_SECRET=

# Optional push provider credentials. Presence is reported in Push Settings.
APNS_KEY=
FCM_SERVICE_ACCOUNT=
WEB_PUSH_PRIVATE_KEY=

# Optional OpenAI-compatible endpoint for configured workspace agents.
WORKSPACE_AI_ENDPOINT=
WORKSPACE_AI_API_KEY=
WORKSPACE_AI_MODEL=
